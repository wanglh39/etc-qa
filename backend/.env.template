# ============================================
# 客服工单流转优化系统 — 环境变量模板
# 复制本文件为 .env 后填入真实值
# cp .env.template .env
# ============================================

# DeepSeek API Key（必填，去 https://platform.deepseek.com 注册获取）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# SiliconFlow API Keys（嵌入/重排模型，逗号分隔多个 key 做负载均衡）
SILICONFLOW_API_KEYS=sk-key1,sk-key2,sk-key3,sk-key4

# 阿里云 NLS 流式ASR（必填：asr.yaml 中 streaming.mode 默认 alicloud）
# 控制台获取: https://nls-portal.console.aliyun.com
ALICLOUD_ASR_APP_KEY=your-app-key-here
ALICLOUD_ASR_ACCESS_KEY_ID=your-access-key-id-here
ALICLOUD_ASR_ACCESS_KEY_SECRET=your-access-key-secret-here

# 流式ASR高级选项（可选，均有默认值）
# ASR_STREAMING_MODE=alicloud
# ASR_STREAMING_AUTO_QUERY=false

# LangSmith 可观测性（可选，去 https://smith.langchain.com 注册获取）
# LANGCHAIN_API_KEY=your_langsmith_key_here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=etc-qa

# MySQL 密码（必填，生产请使用强密码）
ETC_QA_MYSQL_PASSWORD=change-me-strong-password

# CORS（可选，仅前后端分离部署时需要）
# 同源部署（nginx 统一入口）无需配置
# ETC_QA_CORS_ORIGINS=https://your-frontend-domain.com
