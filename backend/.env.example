# ===== 必填 =====

# DeepSeek API Key（LLM调用：规整/分类/HyDE）
DEEPSEEK_API_KEY=sk-your-key-here

# SiliconFlow API Keys（嵌入/重排模型，逗号分隔多个 key 做负载均衡）
SILICONFLOW_API_KEYS=sk-key1,sk-key2,sk-key3,sk-key4

# 阿里云NLS（实时语音识别ASR，https://nls-portal.console.aliyun.com）
ALICLOUD_ASR_APP_KEY=你的AppKey
ALICLOUD_ASR_ACCESS_KEY_ID=你的AccessKeyID
ALICLOUD_ASR_ACCESS_KEY_SECRET=你的AccessKeySecret
ALICLOUD_ASR_HOTWORDS_ID=你的热词表ID

# ASR模式（alicloud=阿里云API, pseudo=本地伪流式）
ASR_STREAMING_MODE=alicloud

# ===== 可选 =====

# MySQL密码（不配则用config.yaml中的默认值123456，生产环境必须配）
# ETC_QA_MYSQL_PASSWORD=123456

# JWT签名密钥（不配则用代码中的默认开发值，生产环境必须配随机值）
# ETC_QA_JWT_SECRET=your-random-secret-here

# 登录账号密码（pbkdf2_sha256 哈希，用 `python scripts/setup/gen_password_hash.py` 生成；不配则用代码默认开发值 123456）
# ETC_QA_ADMIN_PASSWORD=pbkdf2_sha256$260000$<salt>$<hash>
# ETC_QA_SERVICE_PASSWORD=pbkdf2_sha256$260000$<salt>$<hash>
# ETC_QA_DEPT_PASSWORD=pbkdf2_sha256$260000$<salt>$<hash>

# CORS 允许的跨域来源（逗号分隔，不配则用 server.yaml 的 cors_origins）
# ETC_QA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ===== LangSmith（可选，全链路追踪） =====
# 注册 https://smith.langchain.com 获取
# LANGCHAIN_API_KEY=your_key_here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=etc-qa

