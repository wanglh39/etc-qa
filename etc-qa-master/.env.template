# ============================================
# ETC客服QA智能检索系统 — 环境变量模板
# 复制本文件为 .env 后填入真实值
# cp .env.template .env
# ============================================

# DeepSeek API Key（必填，去 https://platform.deepseek.com 注册获取）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# MySQL密码（可选，不配则用默认值123456）
# ETC_QA_MYSQL_PASSWORD=123456

# LangSmith 可观测性（可选，去 https://smith.langchain.com 注册获取）
# LANGCHAIN_API_KEY=your_langsmith_key_here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=etc-qa