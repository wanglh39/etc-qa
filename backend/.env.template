# ============================================
# ETC客服QA智能检索系统 — 环境变量模板
# 复制本文件为 .env 后填入真实值
# cp .env.template .env
# ============================================

# DeepSeek API Key（必填，去 https://platform.deepseek.com 注册获取）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# MySQL密码（可选，不配则用默认值123456）
# ETC_QA_MYSQL_PASSWORD=123456

# 登录账号密码（pbkdf2_sha256 哈希，用 scripts/setup/gen_password_hash.py 生成）
# ETC_QA_ADMIN_PASSWORD=pbkdf2_sha256$260000$<salt>$<hash>
# ETC_QA_SERVICE_PASSWORD=pbkdf2_sha256$260000$<salt>$<hash>
# ETC_QA_DEPT_PASSWORD=pbkdf2_sha256$260000$<salt>$<hash>

# JWT 签名密钥（生产环境必须配随机值）
# ETC_QA_JWT_SECRET=your-random-secret-here

# LangSmith 可观测性（可选，去 https://smith.langchain.com 注册获取）
# LANGCHAIN_API_KEY=your_langsmith_key_here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=etc-qa