# ============================================
# 客服工单流转优化系统 — 环境变量模板
# 复制本文件为 .env 后填入真实值
# cp .env.template .env
# ============================================

# DeepSeek API Key（必填，去 https://platform.deepseek.com 注册获取）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# HuggingFace Token（说话人分离模型需要，去 https://hf.co/settings/tokens 获取）
# HUGGINGFACE_TOKEN=hf_your_token_here
# ASR_DIARIZE_ENABLED=true

# 流式ASR（可选）
# ASR_STREAMING_ENABLED=false
# ASR_STREAMING_MODE=local
# ASR_STREAMING_AUTO_QUERY=false
# ALICLOUD_ASR_APP_KEY=
# ALICLOUD_ASR_ACCESS_KEY_ID=
# ALICLOUD_ASR_ACCESS_KEY_SECRET=

# LangSmith 可观测性（可选，去 https://smith.langchain.com 注册获取）
# LANGCHAIN_API_KEY=your_langsmith_key_here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=etc-qa

# MySQL密码（可选，不配则用默认值123456）
# ETC_QA_MYSQL_PASSWORD=123456