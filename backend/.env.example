# ===== 必填 =====

# DeepSeek API Key（LLM调用：规整/分类/HyDE）
DEEPSEEK_API_KEY=sk-your-key-here

# ===== 可选 =====

# MySQL密码（不配则用config.yaml中的默认值123456，生产环境必须配）
# ETC_QA_MYSQL_PASSWORD=123456

# JWT签名密钥（不配则用代码中的默认开发值，生产环境必须配随机值）
# ETC_QA_JWT_SECRET=your-random-secret-here

# 模型基础路径（不配则用config.yaml中的默认路径 ./models/hub）
# MODEL_BASE_DIR=./models/hub


# ===== LangSmith（可选，全链路追踪） =====
# 注册 https://smith.langchain.com 获取
# LANGCHAIN_API_KEY=your_key_here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=etc-qa

